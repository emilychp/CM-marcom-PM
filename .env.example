# Copy this file to .env for local development, or set these as
# Environment Variables in the Vercel project settings for production.

# PostgreSQL connection string (Neon, Vercel Postgres, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth.js session secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-generated-secret"

# Public URL of the deployed app (used by Auth.js for redirects/cookies)
NEXTAUTH_URL="https://your-app.vercel.app"

# Vercel Blob token — created automatically when you add a Blob store
# to your Vercel project (Storage tab). Only needed in production;
# omitted locally, attachments fall back to a local uploads/ folder.
BLOB_READ_WRITE_TOKEN=""

# Resend API key — for the weekly progress-reminder email (resend.com).
RESEND_API_KEY=""

# Verified sender address in Resend. Falls back to the shared test
# address (which can only deliver to your own Resend account email),
# so set this once a sending domain is verified in Resend.
REMINDER_FROM_EMAIL="onboarding@resend.dev"

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>"
# when triggering /api/cron/weekly-reminder. Generate with:
# openssl rand -base64 32
CRON_SECRET="replace-with-a-generated-secret"
