# Copy this to .env (in the repo root, next to docker-compose.yml) and fill
# in real values. Never commit the real .env file.

# Any value works, but it must match what DATABASE_URL below uses.
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Hostname is "db" because that's the docker-compose service name for
# Postgres — containers on the same compose network reach each other by
# service name, not localhost.
DATABASE_URL=postgresql://app:change-me-to-a-long-random-value@db:5432/app

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# The internal URL people will actually use to reach this app, e.g.
# http://pm.internal.company.com or http://192.168.1.50:3000
NEXTAUTH_URL=http://your-internal-hostname-or-ip:3000

# Optional — only needed if you want the Friday weekly-progress-reminder
# email to keep working (see "Weekly reminder email" in deploy/README.md).
# Leave blank to disable it; the app runs fine without these.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=
CRON_SECRET=
